---
const audiences = [
  {
    icon: "/images/iconoir/business-building.svg",
    title: "Business owners & developers",
    copy: "Established companies planning their next chapter, and developers bringing carefully considered real estate projects.",
  },
  {
    icon: "/images/iconoir/funding-partner.svg",
    title: "Investment partners",
    copy: "Investors and family offices interested in working alongside us on opportunities with a shared long-term outlook.",
  },
  {
    icon: "/images/iconoir/adviser-handshake.svg",
    title: "Introducers & advisers",
    copy: "Advisers who introduce business owners, management teams and property opportunities that fit our investment focus.",
  },
];
---

<section class="section-block bg-white audience-section" data-reveal-section>
  <div class="site-container">
    <div class="audience-layout">
      <div class="section-heading audience-copy" data-reveal-item>
        <h2 class="text-5xl font-bold tracking-normal text-navy">Who we work with</h2>
        <p class="mt-5 text-base font-light leading-7 text-slate-600">
          We work with business owners, experienced developers and investment partners who share
          our commitment to building lasting value.
        </p>
        <p class="mt-4 text-base font-light leading-7 text-slate-600">We take time to understand the people behind each opportunity,
          their plans and the support they need. That understanding shapes
          how we invest and how we work together.</p>
        <p class="mt-6 text-base font-light leading-7 text-slate-600">Not sure where you fit?
          <a class="audience-inline-link font-medium text-orange-dark" href="/contact">Get in touch</a>
        </p>
      </div>

      <div class="audience-cards" data-reveal-group>
        {audiences.map((audience) => (
          <article class="content-panel audience-card">
            <div class="iconoir-badge" aria-hidden="true">
              <img class="iconoir-icon" src={audience.icon} alt="" width="24" height="24" />
            </div>
            <h3 class="mt-5 text-lg font-semibold text-navy">{audience.title}</h3>
            <p class="mt-3 text-sm font-light leading-6 text-slate-600">{audience.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
