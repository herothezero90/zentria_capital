---
import Footer from "./Footer.astro";
---

<div class="site-closing bg-navy text-white">
  <section class="section-block site-closing__cta" data-reveal-section>
    <div class="site-container text-center" data-reveal-item>
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-normal text-white">
        Let's talk about<br>your next move.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base font-light leading-7 text-white/80">
        Whether you're seeking capital or looking to deploy it, we'd like to hear from you.
      </p>
      <div class="mt-8">
        <a class="btn-primary" href="/contact">Start Enquiry</a>
      </div>
    </div>
  </section>

  <Footer variant="home" />
</div>
