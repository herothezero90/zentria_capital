---
import { getCollection } from "astro:content";

// "Selected mandates" — content comes from the Decap-managed `mandates`
// collection. Cards are repeated (with aria-hidden duplicates) so the
// marquee track can scroll -50% in a seamless loop.
const mandates = (await getCollection("mandates")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="mandates" class="section-block mandates-section bg-white" data-reveal-section>
  <div class="site-container">
    <div class="mandates-intro" data-reveal-item>
      <h2 class="text-5xl font-bold tracking-normal text-navy">Selected mandates</h2>
      <p class="mt-5 text-base font-light leading-7 text-slate-600">
        A snapshot of the transactions we structure and originate across debt, equity and joint venture. Specific
        parties remain confidential.
      </p>
    </div>
  </div>

  <div class="mandates-marquee" aria-label="Selected mandates">
    <div class="mandates-marquee__track">
      <div class="mandates-marquee__group">
        {mandates.map((mandate) => (
          <article class="mandate-card">
            <p class="mandate-card__amount">{mandate.data.amount}</p>
            <p class="mandate-card__type">{mandate.data.type}</p>
            <p class="mandate-card__sector">{mandate.data.sector}</p>
          </article>
        ))}
        {mandates.map((mandate) => (
          <article class="mandate-card" aria-hidden="true">
            <p class="mandate-card__amount">{mandate.data.amount}</p>
            <p class="mandate-card__type">{mandate.data.type}</p>
            <p class="mandate-card__sector">{mandate.data.sector}</p>
          </article>
        ))}
      </div>
      <div class="mandates-marquee__group" aria-hidden="true">
        {[...mandates, ...mandates].map((mandate) => (
          <article class="mandate-card">
            <p class="mandate-card__amount">{mandate.data.amount}</p>
            <p class="mandate-card__type">{mandate.data.type}</p>
            <p class="mandate-card__sector">{mandate.data.sector}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
