---
const steps = [
  {
    icon: "/images/iconoir/message-text.svg",
    title: "You reach out",
    copy: "Tell us about your business, project or mandate. Every conversation is treated with complete confidentiality.",
  },
  {
    icon: "/images/iconoir/network.svg",
    title: "We align you",
    copy: "We assess your objectives and funding requirements, then introduce you to aligned partners from our global network, not just any available capital.",
  },
  {
    icon: "/images/iconoir/check-circle.svg",
    title: "We manage the process",
    copy: "From introduction to close, we structure and support the deal end to end, staying involved until the transaction is complete.",
  },
];
---

<section id="how-it-works" class="process-section process-section--home bg-white" data-process-section
  data-reveal-section>
  <div class="process-scene" data-process-scene>
    <div class="process-scene__sticky section-block">
      <div class="site-container">
        <div class="section-heading" data-reveal-item>
          <h2 class="text-5xl font-bold tracking-normal text-navy">How it works</h2>
          <p class="mt-5 max-w-3xl text-base font-light leading-7 text-slate-600">
            A structured process from first conversation to completed deal, built on understanding your objectives
            and aligning the right partners, not simply matching you with the first available capital.
          </p>
        </div>

        <div class="process-grid mt-12" data-process-grid>
          <div class="process-lines" aria-hidden="true" data-process-lines>
            <span class="process-line" data-process-line="1"></span>
            <span class="process-line" data-process-line="2"></span>
          </div>

          {steps.map((step, index) => (
            <article class:list={["process-step", { "is-active": index === 0 }]} data-process-step={index + 1}>
              <div class="process-step-header">
                <div class="process-step-marker" aria-hidden="true">
                  <img class="process-step-icon" src={step.icon} alt="" width="24" height="24" />
                </div>
              </div>
              <h3 class="font-semibold text-navy">{step.title}</h3>
              <p class="mt-3 text-sm font-light leading-6 text-slate-600">{step.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
