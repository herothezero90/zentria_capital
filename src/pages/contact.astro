---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Contact | Zentria Capital"
  description="Get in touch with Zentria Capital. Tell us about your funding requirement or mandate."
  bodyClass="page-contact bg-white font-sans text-navy antialiased"
  themeColor="#F8FAFC"
>
  <header class="page-header page-header--light sticky top-0 z-40">
    <Header theme="light" active="contact" navClass="page-site-header" />
  </header>

  <main>
    <!-- contact section -->
    <section class="section-block">
      <div class="site-container">
        <div class="contact-layout">
          <!-- form -->
          <div class="contact-form-col">

            <div class="content-panel">
              <div id="form-status" class="mb-8" aria-live="polite">
                <p class="text-sm font-medium text-slate-600">
                  Step <span data-current-step>1</span> of 3
                </p>
                <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-200">
                  <div class="progress-bar h-full rounded-full bg-gradient-to-r from-orange-light to-orange-dark"
                    data-progress-bar></div>
                </div>
              </div>

              <form id="enquiry-form" novalidate>
                <!-- step 1 -->
                <section class="form-step" data-step="1">
                  <fieldset>
                    <legend class="text-2xl font-semibold text-navy">What brings you to Zentria?</legend>

                    <div class="mt-8 grid gap-4 md:grid-cols-3" data-segment-options>
                      <label class="radio-card">
                        <input class="sr-only" type="radio" name="segment" value="seeking-capital" />
                        <span class="block text-base font-semibold text-navy">I'm seeking capital</span>
                        <span class="mt-2 block text-sm font-light leading-6 text-slate-600">I have a business or
                          project that needs funding.</span>
                      </label>

                      <label class="radio-card">
                        <input class="sr-only" type="radio" name="segment" value="funding-partner" />
                        <span class="block text-base font-semibold text-navy">I'm a funding partner</span>
                        <span class="mt-2 block text-sm font-light leading-6 text-slate-600">I provide capital and want
                          quality opportunities.</span>
                      </label>

                      <label class="radio-card">
                        <input class="sr-only" type="radio" name="segment" value="introducer" />
                        <span class="block text-base font-semibold text-navy">I'm an introducer / broker</span>
                        <span class="mt-2 block text-sm font-light leading-6 text-slate-600">I refer clients and partner
                          on deals.</span>
                      </label>
                    </div>
                  </fieldset>
                </section>

                <!-- step 2 -->
                <section class="form-step hidden" data-step="2">
                  <fieldset>
                    <legend class="text-2xl font-semibold text-navy" data-step2-legend>Qualification details</legend>

                    <div class="mt-8 space-y-6" data-field-group="seeking-capital">
                      <div class="form-grid">
                        <label class="form-field">
                          <span>Type of capital needed</span>
                          <select name="capitalType">
                            <option value="">Select an option</option>
                            <option value="debt">Debt</option>
                            <option value="equity">Equity</option>
                            <option value="joint-venture">Joint venture</option>
                            <option value="not-sure">Not sure yet</option>
                          </select>
                        </label>

                        <label class="form-field">
                          <span>Approximate amount sought</span>
                          <select name="amountSought">
                            <option value="">Select an option</option>
                            <option value="under-1m">Under £1M</option>
                            <option value="1m-5m">£1M-£5M</option>
                            <option value="5m-20m">£5M-£20M</option>
                            <option value="20m-plus">£20M+</option>
                          </select>
                        </label>
                      </div>

                      <label class="form-field">
                        <span>Purpose</span>
                        <select name="purpose">
                          <option value="">Select an option</option>
                          <option value="growth">Growth</option>
                          <option value="acquisition">Acquisition</option>
                          <option value="development">Development</option>
                          <option value="expansion">Expansion</option>
                          <option value="other">Other</option>
                        </select>
                      </label>
                    </div>

                    <div class="mt-8 hidden space-y-6" data-field-group="funding-partner">
                      <div class="form-grid">
                        <label class="form-field">
                          <span>Capital you provide</span>
                          <select name="capitalProvided">
                            <option value="">Select an option</option>
                            <option value="debt">Debt</option>
                            <option value="equity">Equity</option>
                            <option value="joint-venture">Joint venture</option>
                          </select>
                        </label>

                        <label class="form-field">
                          <span>Typical deal size</span>
                          <select name="dealSize">
                            <option value="">Select an option</option>
                            <option value="under-1m">Under £1M</option>
                            <option value="1m-5m">£1M-£5M</option>
                            <option value="5m-20m">£5M-£20M</option>
                            <option value="20m-plus">£20M+</option>
                          </select>
                        </label>
                      </div>

                      <label class="form-field">
                        <span>Sectors of interest</span>
                        <input type="text" name="sectorsOfInterest" autocomplete="off" />
                      </label>
                    </div>

                    <div class="mt-8 hidden space-y-6" data-field-group="introducer">
                      <label class="form-field">
                        <span>Type of client you're introducing</span>
                        <input type="text" name="clientType" autocomplete="off" />
                      </label>

                      <div class="form-grid">
                        <label class="form-field">
                          <span>Capital they're seeking</span>
                          <select name="clientCapitalSought">
                            <option value="">Select an option</option>
                            <option value="under-1m">Under £1M</option>
                            <option value="1m-5m">£1M-£5M</option>
                            <option value="5m-20m">£5M-£20M</option>
                            <option value="20m-plus">£20M+</option>
                          </select>
                        </label>

                        <label class="form-field">
                          <span>Your relationship to them</span>
                          <input type="text" name="relationship" autocomplete="off" />
                        </label>
                      </div>
                    </div>
                  </fieldset>
                </section>

                <!-- step 3 -->
                <section class="form-step hidden" data-step="3">
                  <fieldset>
                    <legend class="text-2xl font-semibold text-navy">How can we reach you?</legend>

                    <div class="mt-8 space-y-6">
                      <div class="form-grid">
                        <label class="form-field">
                          <span>Full name</span>
                          <input type="text" name="fullName" autocomplete="name" required />
                        </label>

                        <label class="form-field">
                          <span>Email</span>
                          <input type="email" name="email" autocomplete="email" required />
                        </label>
                      </div>

                      <div class="form-grid">
                        <label class="form-field">
                          <span>Company / firm</span>
                          <input type="text" name="company" autocomplete="organization" required />
                        </label>

                        <label class="form-field">
                          <span>Phone <span class="font-normal text-slate-500">(optional)</span></span>
                          <input type="tel" name="phone" autocomplete="tel" />
                        </label>
                      </div>

                      <label class="form-field">
                        <span>Anything else we should know? <span
                            class="font-normal text-slate-500">(optional)</span></span>
                        <textarea name="message" rows="5"></textarea>
                      </label>

                      <!-- Honeypot — hidden from people, catches bots -->
                      <div class="form-hp" aria-hidden="true">
                        <label>Leave this field empty
                          <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
                        </label>
                      </div>

                      <label class="form-consent">
                        <input type="checkbox" name="consent" />
                        <span>I agree to Zentria Capital handling my details in line with its
                          <span class="form-consent__link">privacy policy</span> in order to respond to my
                          enquiry.</span>
                      </label>
                    </div>
                  </fieldset>
                </section>

                <!-- form actions -->
                <div
                  class="mt-10 flex flex-col-reverse gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-between">
                  <button class="btn-secondary hidden" type="button" data-back-button>Back</button>
                  <div class="flex flex-col gap-3 sm:ml-auto sm:flex-row">
                    <button class="btn-primary" type="button" data-next-button>Next</button>
                    <button class="btn-primary hidden" type="submit" data-submit-button>Submit enquiry</button>
                  </div>
                </div>

                <p class="form-reassurance">Confidential · No obligation · A personal reply, usually within one business
                  day.</p>
              </form>

              <div id="thank-you-message" class="hidden py-12 text-center" tabindex="-1">
                <p class="eyebrow">Thank you</p>
                <p class="mx-auto mt-4 max-w-xl text-lg font-light leading-8 text-slate-700">
                  Thank you. We've received your enquiry and will be in touch personally, usually within one business
                  day.
                </p>
                <div class="mt-8">
                  <a class="btn-secondary" href="/">Back to homepage</a>
                </div>
              </div>
            </div>
          </div>

          <aside class="contact-aside">
            <h1 class="text-4xl font-bold tracking-normal text-navy sm:text-5xl">Let's talk.</h1>
            <p class="mt-6 text-lg font-light leading-8 text-slate-700">
              Tell us a little about what you're looking for, and we'll come back to you personally, usually
              within one business day.
            </p>

            <div class="contact-points">
              <div class="contact-point">
                <span class="contact-point__icon" aria-hidden="true">
                  <img src="/images/iconoir/check-circle.svg" alt="" width="24" height="24" />
                </span>
                <div>
                  <h3>Discreet by default</h3>
                  <p>Every enquiry is handled in strict confidence.</p>
                </div>
              </div>
              <div class="contact-point">
                <span class="contact-point__icon" aria-hidden="true">
                  <img src="/images/iconoir/message-text.svg" alt="" width="24" height="24" />
                </span>
                <div>
                  <h3>A personal reply</h3>
                  <p>You'll hear back from us directly, usually within one business day.</p>
                </div>
              </div>
              <div class="contact-point">
                <span class="contact-point__icon" aria-hidden="true">
                  <img src="/images/iconoir/adviser-handshake.svg" alt="" width="24" height="24" />
                </span>
                <div>
                  <h3>No obligation</h3>
                  <p>A conversation to understand your needs, not a commitment.</p>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <!-- footer -->
  <div class="site-closing bg-navy text-white">
    <Footer variant="plain" />
  </div>

  <script is:inline src="/js/form.js" slot="scripts"></script>
</Base>
