---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const posts = (await getCollection("insights")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  title="Insights | TGM Invest"
  description="Perspectives on business growth, real estate and long-term investment from TGM Invest."
  bodyClass="page-contact bg-white font-sans text-navy antialiased"
  themeColor="#F5F6F2"
>
  <header class="page-header page-header--light sticky top-0 z-40">
    <Header theme="light" active="insights" navClass="page-site-header" />
  </header>

  <main>
    <section class="section-block">
      <div class="site-container">
        <div class="section-heading">
          <h1 class="text-5xl font-bold tracking-normal text-navy">Insights</h1>
          <p class="mt-5 text-base font-light leading-7 text-slate-600">
            Thoughts on business growth, real estate and the partnerships behind long-term investment.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="insight-card">
              <a class="insight-card__link" href={`/insights/${post.id}/`}>
                {post.data.image && (
                  <img class="insight-card__image" src={post.data.image} alt="" loading="lazy" />
                )}
                <div class="insight-card__body">
                  <p class="text-xs font-medium uppercase tracking-wide text-orange-dark">
                    {dateFormat.format(post.data.date)}
                  </p>
                  <h2 class="mt-3 font-heading text-xl font-semibold leading-snug text-navy">{post.data.title}</h2>
                  <p class="mt-3 text-sm font-light leading-6 text-slate-600">{post.data.summary}</p>
                  <p class="mt-4 text-sm font-semibold text-orange-dark">Read more →</p>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <div class="site-closing bg-navy text-white">
    <Footer variant="plain" />
  </div>
</Base>
