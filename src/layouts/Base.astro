---
import "../styles/main.css";

// Props: title, description, bodyClass (optional), themeColor (optional)
const {
  title,
  description,
  bodyClass = "bg-white font-sans text-navy antialiased",
  // theme-color intentionally differs per page while the hero concept is undecided
  themeColor = "#173F35",
} = Astro.props;
---

<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/images/tgm-favicon.svg" />
  <link rel="apple-touch-icon" href="/images/tgm-apple-touch-icon.png" />
  <meta name="theme-color" content={themeColor} />
</head>

<body class={bodyClass}>
  <slot />
  <script is:inline src="/js/vendor/anime.min.js"></script>
  <script is:inline src="/js/main.js"></script>
  <slot name="scripts" />
</body>

</html>
